                            <zone forceUpdate='true' h='27490' id='26' type-v2='text' w='12714' x='86143' y='71501'>
                              <formatted-text>
                                <run bold='true' fontsize='14'>Key Findings</run>
                                <run>Æ&#10;</run>
                                <run fontsize='10'>- Shell weight demonstrated the strongest relationship with maturity (r = 0.63)</run>
                                <run>Æ&#10;</run>
                                <run fontsize='10'>- Water temperature showed minimal relationship with maturity (r = -0.02)</run>
                                <run>Æ&#10;</run>
                                <run fontsize='10'>- Female abalones exhibited slightly higher average maturity than male abalones.</run>
                                <run>Æ&#10;</run>
                                <run fontsize='10'>- Physical growth characteristics were stronger predictors of maturity than environmental temperature.</run>
                                <run>Æ&#10;</run>
                                <run fontsize='10'>- Random Forest regression achieved an R^2 score of 0.53 when predicting ring count.</run>
                                <run>Æ&#10;</run>
